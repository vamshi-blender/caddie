# Server-only OpenAI credential. Never expose this to the client.
OPENAI_API_KEY=

# Main chat/agent model.
OPENAI_MODEL=gpt-5.6

# Separate, cheaper/faster model used only to name new conversations.
OPENAI_TITLE_MODEL=gpt-5.6-luna

# Server-only Supabase connection. Use a secret key, never a publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random secret used to sign secure session cookies. Generate it with:
# pnpm auth:generate-secret
CADDIE_AUTH_SECRET=

# Encrypts the shared Oracle credentials stored in Supabase. Generate with:
# pnpm db:generate-config-key
CADDIE_DB_CONFIG_KEY=
